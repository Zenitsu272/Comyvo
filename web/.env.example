NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# Transactional notifications. Required in production.
# RESEND_API_KEY=re_replace_me
# EMAIL_FROM=Comyvo <notifications@your-verified-domain.example>

# SMS phone verification. Required in production.
# TWILIO_ACCOUNT_SID=AC_replace_me
# TWILIO_AUTH_TOKEN=replace_me
# TWILIO_VERIFY_SERVICE_SID=VA_replace_me

# Localhost only. Never configure this on a deployed environment.
LOCAL_PHONE_OTP=123456

# Optional additional institutional domains, comma-separated.
ALLOWED_EMAIL_DOMAINS=
