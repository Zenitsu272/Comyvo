NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me
SUPABASE_SECRET_KEY=sb_secret_replace_me
RATE_LIMIT_SECRET=replace-with-at-least-32-random-characters

# DANGEROUS demo mode: any allowed email + 123456 signs in without email ownership proof.
# Blocks admin/suspended accounts. Set false and redeploy to restore real OTP delivery.
TEMPORARY_LOGIN_ENABLED=false

# OTP and transactional delivery. Resend works with local or hosted Supabase.
OTP_DELIVERY=resend
# Add a real API key and sender from a verified Resend domain.
# RESEND_API_KEY=re_replace_me
# EMAIL_FROM=Comyvo <notifications@your-verified-domain.example>
# For offline tests only: OTP_DELIVERY=supabase uses local Mailpit.

# Alternative without a domain: set OTP_DELIVERY=smtp and use your Gmail account.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=your-account@gmail.com
# SMTP_PASSWORD=your-google-app-password
# EMAIL_FROM=Comyvo <your-account@gmail.com>

# Optional SMS verification. Leave disabled for an email-only launch.
PHONE_VERIFICATION_ENABLED=false
# These credentials are required only when PHONE_VERIFICATION_ENABLED=true.
# TWILIO_ACCOUNT_SID=AC_replace_me
# TWILIO_AUTH_TOKEN=replace_me
# TWILIO_VERIFY_SERVICE_SID=VA_replace_me

# Localhost only. Never configure this on a deployed environment.
# LOCAL_PHONE_OTP=123456

# Optional additional institutional domains, comma-separated.
ALLOWED_EMAIL_DOMAINS=
